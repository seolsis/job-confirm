# Supabase (docs/ARCHITECTURE.md 6장 참고)
# 공유 Supabase 프로젝트 사용 중 — 이 프로젝트의 테이블은 "jobConfirm_" 접두사를 쓴다
# 클라이언트 노출 — Supabase 프로젝트 URL
NEXT_PUBLIC_SUPABASE_URL=https://qnkdudxitfptrgsdgnaa.supabase.co

# 클라이언트 노출 — RLS 전제의 공개 키 (publishable/anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_DqNE3T5sZrhV8xyiRC5FEA_gGAvBKMI

# 서버 전용 — 공유 테이블(job_postings, posting_extractions) 쓰기
SUPABASE_SERVICE_ROLE_KEY=

# 서버 전용 — Claude API (LLM 분석 파이프라인)
ANTHROPIC_API_KEY=

# LLM provider 선택: anthropic(기본, 미설정 시) | gemini
AI_PROVIDER=gemini

# 서버 전용 — Google Gemini API (AI_PROVIDER=gemini일 때 사용)
# 발급: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# 어드민 계정 이메일 (콤마 구분) — /admin 피드백 검토 접근 허용 목록
ADMIN_EMAILS=
